# Copiá este archivo como .env y ajustá los valores. El .env es obligatorio para construir.

# Nombre del proyecto en Docker Compose (prefijo de contenedores, red y volúmenes)
COMPOSE_PROJECT_NAME=planificador-pacientes

# Dominio público que atiende nginx
SERVER_NAME=localhost

# production | development (development habilita /api/docs)
ENVIRONMENT=production

# Puertos publicados en el host (producción: 80 y 443)
NGINX_HTTP_PORT=80
NGINX_HTTPS_PORT=443

# true = redirige todo el tráfico HTTP a HTTPS (usar con certificados reales)
FORCE_HTTPS=false

# PostgreSQL (usá una contraseña larga y aleatoria, solo letras y números)
POSTGRES_DB=planificador
POSTGRES_USER=planificador
POSTGRES_PASSWORD=cambia-esta-contrasena

# Auth0 — ver docs/auth0.md
# Dominio del tenant, p. ej. esthetic-dent.us.auth0.com
AUTH0_DOMAIN=
# Identifier de la API creada en Auth0, p. ej. https://api.planificador.estheticdent
AUTH0_AUDIENCE=
# Client ID de la Application tipo "Single Page Application"
AUTH0_CLIENT_ID=
# Conexión de inicio de sesión: "email" = código de un solo uso por correo, sin contraseña
AUTH0_CONNECTION=email
# Solo para desarrollo local sin Auth0. El backend se niega a arrancar si se usa en producción.
AUTH_DEV_BYPASS=false

# Carga pacientes ficticios si la base está vacía (solo desarrollo)
SEED_DEMO=false
# Tamaño máximo por documento subido (MB)
MAX_UPLOAD_MB=10

# AirLabs: estado de los vuelos (https://airlabs.co). Clave secreta: solo la usa el backend.
AIRLABS_API_KEY=
